{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/worker/local.ts dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "tsx src/worker/local.ts start",
    "dev:live": "tsx src/worker/local.ts dev --live",
    "start:live": "tsx src/worker/local.ts start --live",
    "db:setup": "tsx src/worker/setup.ts",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx src/worker/main.ts",
    "aula:prepare": "tsx src/worker/aula-companion.ts prepare",
    "aula:check": "tsx src/worker/aula-companion.ts check",
    "aula:test": "tsx src/worker/aula-companion.ts test",
    "aula:preflight": "tsx src/worker/aula-session.ts preflight",
    "aula:login": "tsx src/worker/aula-session.ts login",
    "aula:disconnect": "tsx src/worker/aula-session.ts disconnect",
    "aula:validate": "tsx src/worker/aula-validate.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "1.4.4",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bun",
      "esbuild"
    ]
  }
}
