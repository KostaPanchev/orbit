+describe('Orbit private login storage', () => {
+  async function withPrivateLogin(run: (output: () => string) => Promise<void>, failure = false) {
+    const previousPrivate = process.env.AULA_MCP_PRIVATE_SESSION;
+    const previousKey = process.env.AULA_MCP_KEY;
+    process.env.AULA_MCP_PRIVATE_SESSION = '1';
+    delete process.env.AULA_MCP_KEY;
+    const login = spyOn(AulaLoginClient.prototype, 'login');
+    if (failure) login.mockRejectedValue(new Error('FICTIONAL_SECRET_ERROR_PAYLOAD'));
+    else login.mockResolvedValue(FAKE_RECORD.tokens);
+    let output = '';
+    const stdout = spyOn(process.stdout, 'write').mockImplementation((chunk) => {
+      output += String(chunk);
+      return true;
+    });
+    try {
+      await run(() => output);
+    } finally {
+      login.mockRestore();
+      stdout.mockRestore();
+      if (previousPrivate === undefined) delete process.env.AULA_MCP_PRIVATE_SESSION;
+      else process.env.AULA_MCP_PRIVATE_SESSION = previousPrivate;
+      if (previousKey === undefined) delete process.env.AULA_MCP_KEY;
+      else process.env.AULA_MCP_KEY = previousKey;
+    }
+  }
+
