+      expect((await readdir(directory)).sort()).toEqual(['.key', 'tokens.json']);
+      for (const name of ['.key', 'tokens.json']) {
+        expect((await stat(join(directory, name))).mode & 0o777).toBe(0o600);
+      }
+      const ciphertext = await readFile(join(directory, 'tokens.json'), 'utf8');
+      expect(ciphertext).not.toContain('FICTIONAL_GUARDIAN');
+      expect(ciphertext).not.toContain('AT-1');
+      const store = new EncryptedFileTokenStore({
+        filePath: join(directory, 'tokens.json'),
+        keyFilePath: join(directory, '.key'),
+      });
+      expect((await store.load())?.tokens).toEqual(FAKE_RECORD.tokens);
+    });
+  });
+
+  test('refuses debug and transcript options before authentication', async () => {
+    await withPrivateLogin(async () => {
+      await expect(runLogin({ username: 'FICTIONAL', debug: true })).rejects.toThrow('disabled');
+      await expect(runLogin({ username: 'FICTIONAL', transcript: '/not-written' })).rejects.toThrow(
+        'disabled',
+      );
+      expect(await readdir(workDir)).toEqual([]);
+    });
+  });
+
+  test('does not log upstream error payloads or suggest enabling debug on failure', async () => {
+    await withPrivateLogin(async (output) => {
+      const exit = spyOn(process, 'exit').mockImplementation(() => {
